<!--
  ═══════════════════════════════════════════════════════════════════════════
   Vizitor — آتیران ویزیتور | پیکربندی امنیت شبکه
   Developed by Milano Technical Team, Milad Yaghoobi
  ─────────────────────────────────────────────────────────────────────────
   چرا این فایل لازم است؟
     • نصب پیش‌فرض سرور آتیران روی شبکهٔ داخلی شرکت با HTTP انجام می‌شود
       (بدون گواهی SSL). اندروید ۹+ برای اپ‌های targetSdk 28+ ترافیک
       «بدون رمزنگاری» را به‌صورت پیش‌فرض بسته است؛ این فایل آن را برای
       وب‌سرویس داخلی ویزیتور باز می‌کند.
     • خروجی اینترنت برنامه (هوش مصنوعی) همچنان از طریق Cloudflare Worker با
       HTTPS انجام می‌شود و تحت تأثیر این تنظیم نیست.
     • trust-anchors «user» اضافه شده تا اگر مدیر سرور گواهی خودامضای خود
       (مثلاً Vizitor-SERVER.cer) را روی گوشی نصب کند، اتصال HTTPS هم کار کند.
     • اگر سرور شما دامنه و گواهی معتبر دارد، کلید «اتصال امن (HTTPS)» را در
       اپ روشن بگذارید؛ نیازی به تغییر این فایل نیست.
  ═══════════════════════════════════════════════════════════════════════════
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- گواهی‌های نصب‌شده توسط کاربر (گواهی خودامضای سرور داخلی) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
