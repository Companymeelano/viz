<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════
   Vizitor — آتیران ویزیتور | پیکربندی سایت IIS (web.config)
   Developed by Milano Technical Team, Milad Yaghoobi
  ─────────────────────────────────────────────────────────────────────────
   این فایل در ریشهٔ سایت قرار می‌گیرد و سه کار مهم انجام می‌دهد:
     ۱) index.php را به‌عنوان صفحهٔ پیش‌فرض معرفی می‌کند
     ۲) existingResponse=PassThrough می‌کند تا بدنهٔ JSON خطاهای PHP
        (مثل 401 و 500) توسط IIS با صفحهٔ HTML جایگزین نشود — بدون این
        تنظیم، اپ پیام خطای درست را نمی‌گیرد.
     ۳) حجم بدنهٔ درخواست را برای تصویر امضای فاکتور تا ۳۲ مگابایت باز می‌کند.
  ═══════════════════════════════════════════════════════════════════════════
-->
<configuration>
    <system.webServer>

        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.php" />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <httpErrors existingResponse="PassThrough" />

        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="33554432" />
                <hiddenSegments>
                    <!-- فایل تنظیمات هرگز نباید از بیرون قابل واکشی باشد -->
                    <add segment="config.php" />
                    <add segment="config.sample.php" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>
</configuration>
